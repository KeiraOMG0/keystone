# Copy this file to .env and fill in real values. NEVER commit the real .env.
# See docs/ARCHITECTURE.md section 6 for the full reference of every variable.
# Both the bot (config.py) and the dashboard backend (server/config.py) read
# this same root .env file. Restart the relevant process after editing it.

# --- Required ---
# Your Discord server's ID (Developer Mode on, right-click the server, Copy Server ID).
# The bot only works in this server and leaves any other. The dashboard uses it too.
GUILD_ID=
DISCORD_TOKEN=
INTERNAL_API_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
SESSION_COOKIE_SECRET=

# --- Bot core (optional, sane defaults shown) ---
DB_PATH=bot.db
LOG_LEVEL=INFO
DEBUG=false

# --- Kick / verification cog ---
UNVERIFIED_ROLE_ID=0
VERIFIED_ROLE_ID=0
UNVERIFIED_CATEGORY_ID=0
LOG_CHANNEL_ID=0
JOIN_LEAVE_CHANNEL_ID=0
CHECK_INTERVAL_MINUTES=10
AUTO_KICK=true
VERIFY_TEMPLATE_NAME=verify
VERIFY_TICKET_WELCOME_TEMPLATE_NAME=verify-ticket-welcome

# --- Tickets ---
TICKET_CHAT_LOGGING_ENABLED=false
TICKET_ARCHIVE_PURGE_DAYS=30

# --- Permissions ---
# Also read by the dashboard: only this user sees the hidden /dashboard/debug page.
OWNER_ID=0
STAFF_ROLE_IDS=

# --- Internal API (shared between bot process and dashboard process) ---
INTERNAL_API_HOST=127.0.0.1
INTERNAL_API_PORT=8766

# --- Honeypot ---
# Public dashboard URL used in the appeal link DMed to banned honeypot catches.
APPEAL_BASE_URL=https://dash.idlesys.xyz

# --- Fortnite item shop (cogs/fortnite_shop.py) ---
# Optional fortnite-api.com key (the shop endpoint works without one).
FORTNITE_API_KEY=
FORTNITE_SHOP_LANGUAGE=en
# Minutes after the 00:00 UTC shop rotation before the daily post goes out.
FORTNITE_SHOP_POST_DELAY_MINUTES=5

# --- Anti-spam (cogs/anti_spam.py) ---
# Defaults only: every value is also on the dashboard Settings page (Anti-spam
# tab) and applies live. A count of 0 turns that rule off; a timeout of 0 means
# delete the spam without timing the member out.
ANTISPAM_ENABLED=true
ANTISPAM_FLOOD_MESSAGES=6
ANTISPAM_FLOOD_SECONDS=5
ANTISPAM_DUPLICATE_MESSAGES=5
ANTISPAM_DUPLICATE_SECONDS=30
ANTISPAM_MENTION_LIMIT=6
ANTISPAM_TIMEOUT_MINUTES=10

# --- Moderation message log (cogs/message_log.py) ---
# Every server message (not DMs or ticket channels) kept in its own SQLite
# file for this many days (1-30), pruned daily. Read back with !msglog (staff).
MESSAGE_LOG_ENABLED=true
MESSAGE_LOG_PATH=message_log.db
MESSAGE_LOG_RETENTION_DAYS=7

# --- User cache (cogs/user_cache.py) ---
# Last known name/avatar/status of members, so the dashboard can still show
# people who left, were kicked or banned. Own SQLite file (sensitive).
# Departed users kept this many days (0 = forever; still-banned users are kept).
USER_CACHE_ENABLED=true
USER_CACHE_PATH=user_cache.db
USER_CACHE_RETENTION_DAYS=365

# --- Music cog ---
MUSIC_COOKIES_FILE=cookies.txt
# Leave MUSIC_NODE_PATH unset/blank to auto-detect `node` on PATH (works on
# Windows/Mac/Linux as long as `node` resolves in the shell the bot runs in).
# Only set this explicitly to override that lookup, e.g.:
# MUSIC_NODE_PATH=C:/Program Files/nodejs/node.exe
MUSIC_NODE_PATH=
MUSIC_DEFAULT_SEARCH=ytsearch7
MUSIC_ALLOW_PLAYLISTS=true
MUSIC_DEFAULT_VOLUME=50
MUSIC_INACTIVITY_TIMEOUT=600
# yt-dlp YouTube player clients to try, in order (comma-separated).
MUSIC_PLAYER_CLIENTS=tv_simply,tv,web,web_safari
# PO-token companion server (pot_server/), started/stopped by the bot process.
MUSIC_POT_SERVER_ENABLED=true
MUSIC_POT_SERVER_PORT=4416
MUSIC_POT_SERVER_SCRIPT=pot_server/server/build/main.js
# Relative paths resolve against the project root. Bad int/bool values fall
# back to the default with a logged warning.
# Interface the pot server binds to (also what yt-dlp connects to).
MUSIC_POT_SERVER_HOST=127.0.0.1
# Node binary for the pot server only (blank = use MUSIC_NODE_PATH / PATH).
MUSIC_POT_SERVER_NODE=
# Pot server stdout/stderr log (appended, rotated at ~1 MB); PID file sits next to it.
MUSIC_POT_SERVER_LOG=logs/pot_server.log
# Supervise the server: ping every HEALTH_INTERVAL seconds, restart with
# exponential backoff, give up after MAX_RESTARTS consecutive failures.
MUSIC_POT_SERVER_WATCHDOG=true
MUSIC_POT_SERVER_HEALTH_INTERVAL=30
MUSIC_POT_SERVER_MAX_RESTARTS=5
# Seconds before a yt-dlp extraction is abandoned / per-socket network timeout.
MUSIC_EXTRACT_TIMEOUT=90
MUSIC_YTDLP_SOCKET_TIMEOUT=20
# Pass remote_components ejs:github to yt-dlp (true = previous behaviour).
MUSIC_EJS_REMOTE_COMPONENTS=true
# Autoplay (`!autoplay` toggles per guild). Boot default, max autoplay tracks in
# a row, and how many recently played ids it will not repeat.
MUSIC_AUTOPLAY_DEFAULT=false
MUSIC_AUTOPLAY_MAX_CONSECUTIVE=10
MUSIC_AUTOPLAY_HISTORY=25
# Cookie-extension listener (see docs/COOKIE_EXTENSION.md). ON by default and
# speaks the musicbot-cookie-sync extension's API (default port 8999).
# If another program already uses that port, free it or change the port here
# (a busy port only logs a warning and is retried in the background).
# With no secret, requests must come from a browser-extension Origin. Setting a
# secret is optional hardening (then the extension must send X-Cookie-Secret).
# Binds loopback only by default. Keep the port distinct from 8766/8080/4416.
# MUSIC_COOKIE_LISTENER_ENABLED=true
# MUSIC_COOKIE_LISTENER_HOST=127.0.0.1
# MUSIC_COOKIE_LISTENER_PORT=8999
# MUSIC_COOKIE_LISTENER_SECRET=
# Optional: comma list of extension ids allowed when no secret is set.
# MUSIC_COOKIE_LISTENER_EXTENSION_IDS=
# MUSIC_COOKIE_LISTENER_MAX_BYTES=524288
# MUSIC_COOKIE_LISTENER_RATE_PER_MIN=30
# !debugurl: extra query params to mask (comma list, extends the defaults) and
# domains/keywords whose inputs are refused.
# MUSIC_DEBUGURL_MASK_PARAMS=
# MUSIC_DEBUGURL_BLOCKED=

# --- Dashboard backend (server/) ---
DISCORD_OAUTH_REDIRECT_URI=http://localhost:8080/api/auth/callback
# Public ban-appeal sign-in redirect (optional; default = same origin as above +
# /api/public/appeal-auth/callback). Must also be registered in the Developer Portal.
# APPEAL_OAUTH_REDIRECT_URI=http://localhost:8080/api/public/appeal-auth/callback
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
FRONTEND_BASE_URL=http://localhost:8080
# Leave commented to use GUILD_ID (the normal case); an empty value is treated as unset.
# DASHBOARD_GUILD_ID=
# Secure flag on session/OAuth cookies: auto (default; Secure when the request came over HTTPS,
# e.g. via cloudflared, and not on http://localhost), true (always) or false (never)
DASHBOARD_COOKIE_SECURE=auto
# FastAPI /docs, /redoc, /openapi.json (list every route, hidden ones included); local dev only
# DASHBOARD_API_DOCS=false
# Sliding session lifetime, default 30 days
DASHBOARD_SESSION_MAX_AGE_SECONDS=2592000
# touch_session writes last_seen_at at most this often (seconds)
# DASHBOARD_SESSION_TOUCH_INTERVAL_SECONDS=300
# Live updates (WebSocket, ARCHITECTURE section 22); false = no upstream connection, browsers poll
# DASHBOARD_LIVE_ENABLED=true
# Browser socket session+permission re-check interval (seconds)
# DASHBOARD_WS_REVALIDATE_SECONDS=60
# Upstream reconnect backoff cap (seconds); retries forever
# DASHBOARD_WS_BACKOFF_CAP_SECONDS=15

# --- setup_server.py only (not read by the bot) ---
# Only needed if the bot is in more than one guild; otherwise auto-detected.
SETUP_GUILD_ID=

# --- QOTD (optional, read directly via os.environ, not config.py) ---
OLLAMA_URL=http://localhost:11434
# Default model is llama3.2:3b; uncomment only to override (an empty value would shadow the default).
# OLLAMA_MODEL=llama3.2:3b
OLLAMA_EXE=

# --- Supervisor (supervisor.py, optional) ---
# Discord webhook URL for crash alerts (Server Settings -> Integrations -> Webhooks).
SUPERVISOR_WEBHOOK_URL=
# Weekly dependency audit (cogs/dependency_audit.py): its own webhook, else SUPERVISOR_WEBHOOK_URL.
DEPENDENCY_AUDIT_WEBHOOK_URL=
# Lowest npm severity reported (critical, high, moderate, low, info) and packages never reported.
DEPENDENCY_AUDIT_MIN_SEVERITY=moderate
DEPENDENCY_AUDIT_IGNORE=
# Who to ping on a crash: a user ID, or "&ROLEID" for a role. Defaults to OWNER_ID.
SUPERVISOR_PING=
# Lines of the crashed process's output included in the alert (default 15).
# SUPERVISOR_TAIL_LINES=15
# Control API (loopback 127.0.0.1 only) used by /restart in Discord and the
# dashboard's Diagnostics -> Services card. Read by supervisor.py, the bot and
# the dashboard. Defaults: port 8767, secret = INTERNAL_API_SECRET, cooldown 30s.
# SUPERVISOR_CONTROL_PORT=8767
# SUPERVISOR_CONTROL_SECRET=
# SUPERVISOR_RESTART_COOLDOWN=30
